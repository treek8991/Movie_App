# =====================================================================
# .env.example  (Phase 4: Backend Setup)
# ---------------------------------------------------------------------
# This is a TEMPLATE. Copy it to a new file named `.env` (no extension)
# and fill in real values. The real `.env` is ignored by Git so secrets
# never end up on GitHub.
#
# How to use:
#   cp .env.example .env
# =====================================================================

# The TCP port the Express server listens on.
PORT=4000

# PostgreSQL connection settings. These match the values used in
# docker-compose.yml so the backend can reach the database container.
DB_HOST=localhost
DB_PORT=5432
DB_USER=movie_user
DB_PASSWORD=movie_password
DB_NAME=movie_app
