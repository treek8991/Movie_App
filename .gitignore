# =====================================================================
# .gitignore
# ---------------------------------------------------------------------
# Tells Git which files to ignore. These never get committed or pushed
# to GitHub. We ignore three categories:
#   1. Installed dependencies (huge, regenerable from package.json)
#   2. Secrets (anything in a .env file)
#   3. Operating system clutter
# =====================================================================

# --- Node.js installed packages -----------------------------
# node_modules can contain tens of thousands of files. Anyone
# who clones the repo regenerates it by running `npm install`.
node_modules

# --- Environment variable files (SECRETS) -------------------
# .env holds database passwords, API keys, etc. Never commit these.
# We DO commit a .env.example template so others know what keys to set.
.env
.env.local
.env.*.local

# --- Build output -------------------------------------------
# Vite produces a `dist` folder when you run `npm run build`.
# It is generated, never edited by hand, so do not version it.
dist
build

# --- Editor / OS clutter ------------------------------------
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea

# --- Logs ----------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# --- Docker volumes (we mount them locally) -----------------
postgres_data

.env.production
